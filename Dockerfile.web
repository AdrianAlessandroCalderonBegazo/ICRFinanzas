# Build web servida como sitio estático — mismo patrón de despliegue
# (Docker + Traefik) que ya usan el ERP (ICR-LOGISTICA), la tienda pública
# (ICR-TIENDA) y el Cotizador (PrototipoAPPCotizaciones) en el VPS de
# Inversiones ICR.
#
# EXPO_PUBLIC_ERP_API_URL se "hornea" en el bundle JS en tiempo de build
# (Expo inlinea process.env.EXPO_PUBLIC_* al exportar, no lo lee en runtime
# como Next.js) — por eso es un ARG acá, no una variable de entorno del
# contenedor final. Ver docker-compose.yml.
FROM node:22-alpine AS build
WORKDIR /app
ARG EXPO_PUBLIC_ERP_API_URL=https://erp.inversionesicr.com/api
ENV EXPO_PUBLIC_ERP_API_URL=${EXPO_PUBLIC_ERP_API_URL}
COPY app/package.json app/package-lock.json ./
RUN npm ci
COPY app/ ./
RUN npx expo export -p web --output-dir dist

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
