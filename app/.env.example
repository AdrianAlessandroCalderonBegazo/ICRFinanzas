# URL base de la API del ERP (ICR-LOGISTICA). EXPO_PUBLIC_* porque esta app
# corre también en el navegador (finanzas.inversionesicr.com): a diferencia
# de ICR-TIENDA (que llama al ERP solo desde su backend de Next.js, con un
# token de servicio que nunca llega al navegador), ICR Finanzas es una app
# para el propio personal de campo — cada quien entra con su cuenta real del
# ERP (ver src/lib/api.ts), así que no hay un secreto que proteger acá.
EXPO_PUBLIC_ERP_API_URL=https://erp.inversionesicr.com/api
